{
  "name": "so-don-kinh",
  "version": "1.0.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "npm run build:web && tsx src/server/main.ts",
    "build:web": "esbuild src/web/app.ts --bundle --format=esm --outfile=dist/web/app.js --sourcemap && node -e \"require('fs').copyFileSync('src/web/index.html','dist/web/index.html')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tucuong2308/eyewear-management.git"
  },
  "bugs": {
    "url": "https://github.com/tucuong2308/eyewear-management/issues"
  },
  "homepage": "https://github.com/tucuong2308/eyewear-management#readme",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
