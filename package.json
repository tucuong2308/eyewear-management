{
  "name": "so-don-kinh",
  "version": "1.0.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "npm run build:web && esbuild src/server/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/dev-server.mjs --log-level=warning && node dist/dev-server.mjs",
    "build:web": "esbuild src/web/app.ts --bundle --format=esm --outfile=dist/web/app.js --sourcemap && node -e \"require('fs').copyFileSync('src/web/index.html','dist/web/index.html')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:exe": "node scripts/build-exe.mjs",
    "nhap-thang-11": "esbuild scripts/nhap-thang-11.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/nhap-thang-11.mjs --log-level=warning && node dist/nhap-thang-11.mjs",
    "build:apps-script": "node scripts/build-apps-script.mjs",
    "do-toc-do": "esbuild scripts/do-toc-do.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/do-toc-do.mjs --log-level=warning && node dist/do-toc-do.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tucuong2308/eyewear-management.git"
  },
  "bugs": {
    "url": "https://github.com/tucuong2308/eyewear-management/issues"
  },
  "homepage": "https://github.com/tucuong2308/eyewear-management#readme",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "esbuild": "^0.24.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "qrcode-generator": "^1.4.4"
  }
}
